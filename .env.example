# 驾考刷题王 — 题目接口（必填才能拉题）
# 入口：/jztk 选科目一或科目四；刷题页 /jztk/practice 进入即拉题，请求带 subject=1|4，并带本批题量 size=10（默认 10 题/批，可用 VITE_JZTK_BATCH_SIZE 改，VITE_JZTK_BATCH_SIZE_PARAM 改参数名如 count）。
# 刷题页左上角「当前题/总题数」的总数（仅展示用，默认 1700）：VITE_JZTK_TOTAL_QUESTIONS=1700
# 聚合数据示例（须带 key、subject、model 等）：http://v.juhe.cn/jztk/query?key=你的KEY&subject=1&model=c1&testType=rand
# Spring Boot 示例（返回题目数组 JSON，字段 questionText / imageUrl / questionId 等会自动映射）：
VITE_JZTK_API_URL=http://localhost:10000/jztk/question/random
# 也推荐用你自己的后端代理（key 不放前端）
# VITE_JZTK_API_URL=http://v.juhe.cn/jztk/query?key=95427743aa704eebbb7926afc50868d0&subject=1&model=c1&testType=rand

# 每次拉题成功后，POST 完整 JSON 到 Spring Boot（可选；不配则仅前端刷题不落库）
# 示例（端口、路径与后端一致，常见为 8080 + /api/jztk/sync）：
# VITE_JZTK_SYNC_URL=http://43.139.64.144:8080/api/jztk/sync
VITE_JZTK_SYNC_URL=

# 同步接口可选 Bearer Token
# VITE_JZTK_SYNC_TOKEN=

# 已配置 VITE_JZTK_SYNC_URL 时仍要每次拉题后下载 JSON 备份：1 / true
VITE_JZTK_ALSO_DOWNLOAD=true
