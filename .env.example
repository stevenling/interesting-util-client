# ---------- 账号（FastAPI + MySQL users 表）----------
# 注册/登录走 /api/auth/*；需 npm run server 且配置 server/.env。纯前端演示可设为 false
VITE_USE_SERVER_AUTH=true
# ------------------------------------------------------

# 驾考刷题王 — 题目接口（必填才能拉题）
# 入口：/jztk 选科目一或科目四；刷题页 /jztk/practice 进入即拉题，请求带 subject=1|4，并带本批题量 size=10（默认 10 题/批，可用 VITE_JZTK_BATCH_SIZE 改，VITE_JZTK_BATCH_SIZE_PARAM 改参数名如 count）。
# 刷题页左上角「当前题/总题数」的总数（仅展示用，默认 1700）：VITE_JZTK_TOTAL_QUESTIONS=1700
#
# ---------- 生产：Nginx 同源反代（推荐，详见 docs/JZTK_NGINX.md）----------
# 只配基址 /api，代码会拼 VITE_JZTK_API_RANDOM_PATH（默认 /jztk/question/random）
# VITE_JZTK_API_URL=/api
# VITE_JZTK_SYNC_URL=/api/jztk/sync
# -------------------------------------------------------------------
#
# 开发：推荐 /api，由 Vite 代理到 FastAPI（默认 http://127.0.0.1:11219，勿用 localhost 以免 IPv6 拒连；可设 VITE_DEV_PROXY_TARGET 覆盖）
# 直连 FastAPI（须后端 CORS）示例，若未含 …/question/random 仍会拼 API_RANDOM_PATH：
# VITE_JZTK_API_URL=http://127.0.0.1:11219/api
# 聚合数据示例：http://v.juhe.cn/jztk/query?key=你的KEY&subject=1&model=c1&testType=rand
# VITE_JZTK_API_URL=http://v.juhe.cn/jztk/query?key=xxx&subject=1&model=c1&testType=rand

VITE_JZTK_API_URL=/api

# 每次拉题成功后，POST 完整 JSON 到后端（可选；不配则仅前端刷题不落库）
# VITE_JZTK_SYNC_URL=http://43.139.64.144:8080/api/jztk/sync
VITE_JZTK_SYNC_URL=

# 同步接口可选 Bearer Token
# VITE_JZTK_SYNC_TOKEN=

# ---------- EPUB → PDF（ebook-convert-server）----------
# 开发时留空：请求走同源 /ebook-convert，由 vite 代理到下面目标，避免 Failed to fetch（CORS）
# 若写死 http://localhost:3001 会从浏览器直连，转换服务须返回 CORS 头
# VITE_EBOOK_CONVERT_API=
# Vite 代理转发目标（手机通过局域网 IP 访问 :8080 时，常需改为 http://192.168.x.x:3001）
# VITE_EBOOK_CONVERT_PROXY_TARGET=http://localhost:3001
