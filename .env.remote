# npm run dev:remote（vite --mode remote）
# 浏览器只访问 localhost:8080/api/...，由 Vite 转发到 VITE_DEV_PROXY_TARGET。
#
# 重要：127.0.0.1:11219 仅当「本机」已 npm run server（FastAPI）时有效。
# FastAPI 在远程服务器时，这里写公网地址，例如：
#   VITE_DEV_PROXY_TARGET=http://你的服务器公网IP:11219
# 或内网穿透/域名：http://api.example.com:11219
VITE_APP_MODE=dev

VITE_JZTK_API_URL=/api
VITE_DEV_PROXY_TARGET=http://43.139.64.144:11219

VITE_JZTK_SYNC_URL=
