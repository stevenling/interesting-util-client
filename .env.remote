# npm run dev:remote（vite --mode remote）
# 浏览器只访问 localhost:8080/api/...，由 Vite 转发到 VITE_DEV_PROXY_TARGET。
#
# 重要：127.0.0.1:10000 仅当「本机同一台电脑」上跑着若依时才有效。
# 若依在远程服务器（如云上 Debian），这里必须写远程地址，例如：
#   VITE_DEV_PROXY_TARGET=http://你的服务器公网IP:10000
# 或内网穿透/域名：http://api.example.com:10000
VITE_APP_MODE=dev

VITE_JZTK_API_URL=/api
VITE_DEV_PROXY_TARGET=http://43.139.64.144:10000

VITE_JZTK_SYNC_URL=
